[Unit]
Description=Zyvor Device Agent
Documentation=https://zyvor.dev
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/zyvor-device-agent --config /etc/zyvor/device-agent.toml serve
Restart=always
RestartSec=3
# Give the daemon's graceful-shutdown path (drains in-flight HTTP/SSE
# connections and background loops on SIGTERM before exiting) time to finish
# before systemd escalates to SIGKILL.
TimeoutStopSec=15
User=root
Group=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/zyvor-device-agent /run/zyvor-device-agent /etc/zyvor/device-agent/tls
RuntimeDirectory=zyvor-device-agent
RuntimeDirectoryMode=0750
UMask=0077
# No DeviceAllow= entries: DevicePolicy=auto with zero DeviceAllow= installs
# no cgroup device-filter BPF program at all, so root's existing /dev/video*
# access (--features camera) already works with no unit change - do not
# "fix" this into a DeviceAllow=char-video4linux line believing it's
# currently blocked. See docs/HARDWARE_PERMISSIONS.md.
DevicePolicy=auto
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
Environment=RUST_LOG=zyvor_device_agent=info

[Install]
WantedBy=multi-user.target
