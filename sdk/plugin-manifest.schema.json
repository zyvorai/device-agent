{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zyvor Device Agent plugin manifest v2",
  "type": "object",
  "required": ["protocol", "name", "version", "command", "capabilities"],
  "properties": {
    "protocol": { "const": "v2" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["i2c", "gpio", "network", "camera", "filesystem", "none"]
      }
    },
    "runtime": { "type": "string", "enum": ["native", "wasi"] }
  }
}
